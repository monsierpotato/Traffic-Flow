# Backend-only deployment: model inference runs in AI_SERVING_URL.
APP_ENV=production

# Required persistence/broker services. Do not enable the local JSON fallback
# on a multi-process or multi-instance production deployment.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=trafficflow
MONGODB_LOCAL_FALLBACK=false
MONGODB_STRICT_INDEXES=true
MONGODB_TLS=true
REDIS_URL=redis://<redis-host>:6379/0
CELERY_QUEUE_NAME=trafficflow_queue
CELERY_VISIBILITY_TIMEOUT_SECONDS=7200

# Browser origin(s), comma-separated.
CORS_ORIGINS=https://<frontend-host>

# The worker must be able to resolve and reach the API from its own network.
# Use the public API URL for separate hosts or the service name in Compose.
CALLBACK_HOST=https://<api-host>
CALLBACK_TOKEN=<random-service-token>
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_RETRY_ATTEMPTS=4
CALLBACK_RETRY_BACKOFF_SECONDS=1
API_AUTH_REQUIRED=true
API_AUTH_TOKEN=<random-pilot-api-token>
API_DOCS_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
TASK_STALE_TIMEOUT_SECONDS=3600

# Use R2 (or another public/object-storage URL) so the worker can download
# uploaded media and the frontend can consume result URLs.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
R2_BUCKET_NAME=trafficflow
R2_PUBLIC_URL=https://<public-r2-or-cdn-host>
R2_URL_MODE=presigned
R2_PRESIGNED_URL_TTL_SECONDS=3600
STORE_ORIGINAL_VIDEO=false

# Model is intentionally external to this deployment.
AI_LOCAL=false
AI_SERVING_URL=https://<model-service-host>
AI_MODEL_DIR=/var/empty/trafficflow-models
AI_MODEL_PATH=external-model
AI_IMGSZ=640
AI_CLASS_IDS=2,3,5,7
AI_CONFIDENCE=0.4
AI_IOU=0.45
AI_MAX_DET=100

# Video/live processing logic still runs on this backend host.
LIVE_READER_BACKEND=auto
LIVE_FFMPEG_BIN=ffmpeg
LIVE_FFPROBE_BIN=ffprobe
LIVE_BLOCK_PRIVATE_NETWORKS=true
LIVE_MAX_SESSIONS=4
LIVE_MAX_SESSIONS_PER_CLIENT=2
MAX_FILE_SIZE_MB=2048
MAX_CHUNK_SIZE_MB=64
CHUNK_SESSION_TTL_SECONDS=86400
RETENTION_DAYS=3
STORAGE_DIR=/var/lib/trafficflow/storage
