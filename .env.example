APP_ENV=local
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB_NAME=trafficflow
MONGODB_LOCAL_FALLBACK=true
MONGODB_TLS=false
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1500
MONGODB_CONNECT_TIMEOUT_MS=1500
MONGODB_STRICT_INDEXES=true
LOCAL_DB_PATH=storage/local_db.json
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
CELERY_QUEUE_NAME=trafficflow_queue
CELERY_VISIBILITY_TIMEOUT_SECONDS=7200
CALLBACK_HOST=
CALLBACK_TOKEN=
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_RETRY_ATTEMPTS=4
CALLBACK_RETRY_BACKOFF_SECONDS=1
API_AUTH_REQUIRED=false
API_AUTH_TOKEN=
API_DOCS_ENABLED=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LIVE_BLOCK_PRIVATE_NETWORKS=true
LIVE_MAX_SESSIONS=4
LIVE_MAX_SESSIONS_PER_CLIENT=2
LIVE_SESSION_TTL_SECONDS=86400
TASK_STALE_TIMEOUT_SECONDS=3600
CORS_ORIGINS=http://127.0.0.1:8080
R2_ACCOUNT_ID=placeholder_account_id
R2_ACCESS_KEY_ID=placeholder_access_key
R2_SECRET_ACCESS_KEY=placeholder_secret_key
R2_BUCKET_NAME=trafficflow
R2_PUBLIC_URL=http://127.0.0.1:8000/api/v1/upload/assets
R2_URL_MODE=public
R2_PRESIGNED_URL_TTL_SECONDS=3600
AI_LOCAL=true
AI_MODEL_DIR=inference/models
AI_MODEL_PATH=yolov8n.pt
AI_DEVICE=0
AI_IMGSZ=640
AI_FRAME_SKIP=1
ROI_MODE=crop_rect
MAX_FILE_SIZE_MB=2048
MAX_CHUNK_SIZE_MB=64
CHUNK_SESSION_TTL_SECONDS=86400
