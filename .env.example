APP_ENV=local
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB_NAME=trafficflow
MONGODB_LOCAL_FALLBACK=true
MONGODB_TLS=false
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1500
MONGODB_CONNECT_TIMEOUT_MS=1500
LOCAL_DB_PATH=storage/local_db.json
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
CELERY_QUEUE_NAME=trafficflow_gpu_queue
CALLBACK_HOST=http://127.0.0.1:8000
CALLBACK_TOKEN=
CORS_ORIGINS=http://127.0.0.1:5173
YTDLP_TIMEOUT_SECONDS=45
YTDLP_REFRESH_MARGIN_SECONDS=120
YTDLP_COOKIES_FILE=
YTDLP_JS_RUNTIME=
YTDLP_REMOTE_COMPONENTS=
LIVE_PREVIEW_TIMEOUT_SECONDS=20
LIVE_SOURCE_TTL_SECONDS=3600
LIVE_SESSION_RETENTION_SECONDS=600
LIVE_MAX_SESSIONS=2
# Enabled only for APP_ENV=production/prod; local development keeps localhost sources usable.
LIVE_BLOCK_PRIVATE_HOSTS=true
R2_ACCOUNT_ID=placeholder_account_id
R2_ACCESS_KEY_ID=placeholder_access_key
R2_SECRET_ACCESS_KEY=placeholder_secret_key
R2_BUCKET_NAME=trafficflow
R2_PUBLIC_URL=http://127.0.0.1:8000/static
AI_LOCAL=true
# Configure a reachable remote inference API when local weights/runtime are absent.
AI_SERVING_URL=
AI_MODEL_DIR=inference/models
AI_MODEL_PATH=yolov8n.pt
AI_DEVICE=0
AI_IMGSZ=640
AI_FRAME_SKIP=1
ROI_MODE=crop_rect
MAX_FILE_SIZE_MB=2048
